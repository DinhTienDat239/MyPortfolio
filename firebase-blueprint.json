{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Main personal information and site configuration.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "dob": { "type": "string" },
        "roles": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "aboutMe": { "type": "string" },
        "profilePic": { "type": "string" },
        "imageSize": { "type": "number" },
        "primaryColor": { "type": "string" }
      },
      "required": ["fullName", "email"]
    },
    "Playable": {
      "title": "Playable Ad",
      "description": "A playable ad project.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "iframeUrl": { "type": "string" },
        "thumbnail": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "iframeUrl"]
    },
    "Game": {
      "title": "Game Project",
      "description": "A game development project.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "externalLink": { "type": "string" },
        "mainImage": { "type": "string" },
        "bgImage": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["title", "externalLink"]
    },
    "Award": {
      "title": "Award",
      "description": "An award or achievement.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "checkoutLink": { "type": "string" },
        "showCheckout": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name"]
    },
    "Stat": {
      "title": "Statistic",
      "description": "A counter stat for the showcase.",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["label", "value"]
    },
    "Network": {
      "title": "Ad Network",
      "description": "A supported ad network logo.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["name"]
    }
  },
  "firestore": {
    "/config/profile": {
      "schema": "Profile",
      "description": "The site owner's profile."
    },
    "/playables/{playableId}": {
      "schema": "Playable",
      "description": "Collection of playable ads."
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "Collection of game projects."
    },
    "/awards/{awardId}": {
      "schema": "Award",
      "description": "Collection of awards."
    },
    "/stats/{statId}": {
      "schema": "Stat",
      "description": "Collection of statistics."
    },
    "/networks/{networkId}": {
      "schema": "Network",
      "description": "Collection of supported networks."
    }
  }
}
