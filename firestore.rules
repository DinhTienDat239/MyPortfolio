rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "scd239@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /config/profile {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /playables/{playableId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /awards/{awardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /networks/{networkId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
